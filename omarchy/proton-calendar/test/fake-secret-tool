#!/usr/bin/env bash
set -euo pipefail
identifier="${@: -1}"
path="$PROTONCAL_TEST_SECRET_DIR/$identifier"
case "$1" in
  store) mkdir -p "$PROTONCAL_TEST_SECRET_DIR"; IFS= read -r value || true; printf '%s' "$value" > "$path" ;;
  lookup) [[ -f "$path" ]] && sed -n '1p' "$path" ;;
  clear) rm -f "$path" ;;
  *) exit 2 ;;
esac
