{
  "schemaVersion": 1,
  "id": "io.github.itsmoorgrove.protoncalendar",
  "name": "Proton Calendar",
  "version": "0.4.1",
  "author": "moorgrove",
  "license": "MIT",
  "description": "Proton Calendar in the Omarchy bar: next event, month grid, and week grid.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Proton Calendar",
    "description": "Proton Calendar in the Omarchy bar: next event, month grid, and week grid.",
    "category": "Time",
    "aliases": [
      "calendar",
      "proton-calendar",
      "proton",
      "omarchy",
      "quickshell",
      "notifications",
      "reminders"
    ],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "refreshIntervalSec": 900,
      "barMode": "Countdown",
      "defaultView": "Month",
      "weekStartDay": "Sunday",
      "language": "System",
      "timeFormat": "System",
      "secondaryTimeZone": "",
      "showWeekNumbers": true,
      "dayStartHour": 7,
      "dayEndHour": 22,
      "quickAddDurationMinutes": 60,
      "notificationsEnabled": true,
      "notificationSoundEnabled": true,
      "notificationSound": "Alarm",
      "reminderMinutes": 60,
      "reminderMinutesList": [
        60
      ],
      "allDayNotificationsEnabled": false,
      "allDayReminderDays": 1,
      "allDayReminderHour": 9,
      "feedsFile": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 86400,
        "step": 60,
        "defaultValue": 900,
        "description": "How often the shared calendar feeds are re-fetched."
      },
      {
        "key": "barMode",
        "type": "enum",
        "label": "Bar display",
        "options": [
          "Off",
          "Next event",
          "Countdown",
          "Today count",
          "Current event",
          "Privacy"
        ],
        "defaultValue": "Countdown",
        "description": "What appears beside the calendar icon. Privacy never exposes event titles."
      },
      {
        "key": "defaultView",
        "type": "enum",
        "label": "Opening view",
        "options": [
          "Month",
          "Week",
          "Day",
          "Upcoming"
        ],
        "defaultValue": "Month",
        "description": "Which view the panel opens on. Upcoming is a dated list of everything ahead."
      },
      {
        "key": "language",
        "type": "enum",
        "label": "Language",
        "options": [
          "System",
          "English",
          "Swedish"
        ],
        "defaultValue": "System"
      },
      {
        "key": "timeFormat",
        "type": "enum",
        "label": "Clock format",
        "options": [
          "System",
          "24-hour",
          "12-hour"
        ],
        "defaultValue": "System"
      },
      {
        "key": "secondaryTimeZone",
        "type": "string",
        "label": "Secondary time zone",
        "defaultValue": "",
        "description": "Optional IANA name such as Europe/London or UTC."
      },
      {
        "key": "showWeekNumbers",
        "type": "boolean",
        "label": "Show week numbers",
        "defaultValue": true
      },
      {
        "key": "weekStartDay",
        "type": "enum",
        "label": "Week starts on",
        "options": [
          "Sunday",
          "Monday"
        ],
        "defaultValue": "Sunday",
        "description": "First day shown in the month and week views."
      },
      {
        "key": "dayStartHour",
        "type": "integer",
        "label": "Week view starts at (hour)",
        "min": 0,
        "max": 23,
        "step": 1,
        "defaultValue": 7
      },
      {
        "key": "dayEndHour",
        "type": "integer",
        "label": "Week view ends at (hour)",
        "min": 1,
        "max": 24,
        "step": 1,
        "defaultValue": 22
      },
      {
        "key": "quickAddDurationMinutes",
        "type": "integer",
        "label": "Quick add duration (minutes)",
        "min": 5,
        "max": 1440,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "notificationsEnabled",
        "type": "boolean",
        "label": "Event notifications",
        "defaultValue": true,
        "description": "Show a desktop notification before timed events."
      },
      {
        "key": "notificationSoundEnabled",
        "type": "boolean",
        "label": "Notification sound",
        "defaultValue": true,
        "description": "Play the desktop alarm sound with calendar notifications."
      },
      {
        "key": "notificationSound",
        "type": "enum",
        "label": "Notification sound",
        "options": [
          "Gentle",
          "Bell",
          "Chime",
          "Alarm"
        ],
        "defaultValue": "Alarm",
        "description": "Sound played with calendar notifications."
      },
      {
        "key": "reminderMinutes",
        "type": "integer",
        "label": "Notify before event (minutes)",
        "min": 1,
        "max": 10080,
        "step": 1,
        "defaultValue": 60,
        "description": "Default reminder time. Individual events can override it in the widget."
      },
      {
        "key": "allDayNotificationsEnabled",
        "type": "boolean",
        "label": "All-day notifications",
        "defaultValue": false
      },
      {
        "key": "allDayReminderDays",
        "type": "integer",
        "label": "All-day reminder days before",
        "min": 0,
        "max": 30,
        "step": 1,
        "defaultValue": 1
      },
      {
        "key": "allDayReminderHour",
        "type": "integer",
        "label": "All-day reminder hour",
        "min": 0,
        "max": 23,
        "step": 1,
        "defaultValue": 9
      },
      {
        "key": "feedsFile",
        "type": "path",
        "label": "Feeds file",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.config/omarchy/protoncalendar/feeds.json."
      }
    ]
  }
}
